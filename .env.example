# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=INFO
SECRET_KEY=cloudstack-automation-secret-key-change-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# Database Configuration (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./data/cloudstack_automation.db
# DATABASE_URL=postgresql://user:password@localhost:5432/cloudstack_automation

# SSH Configuration & Defaults
SSH_TIMEOUT=30
SSH_AUTH_TIMEOUT=10
MAX_CONCURRENT_SSH=5

# AI / LLM Advisor Configuration (Optional)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=gpt-4o-mini
# LLM_PROVIDER=openai # openai or anthropic
